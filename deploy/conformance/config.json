{
  "alias": "signari",
  "description": "signari engine -- Basic OP",
  "server": {
    "discoveryUrl": "https://signari-engine:8080/.well-known/openid-configuration",
    "allow_unexpected_metadata_fields": [
      "permission_endpoint",
      "client_attestation_pop_methods_supported"
    ]
  },
  "client": {
    "client_id": "conformance-1",
    "client_secret": "REPLACE-WITH-THE-SECRET-setup.sh-PRINTED"
  },
  "client2": {
    "client_id": "conformance-2",
    "client_secret": "REPLACE-WITH-THE-SECRET-setup.sh-PRINTED"
  },
  "consent": {},
  "browser": [
    {
      "match": "https://signari-engine:8080/oauth2/authorize*",
      "tasks": [
        {
          "task": "Sign in",
          "match": "https://signari-engine:8080/oauth2/authorize*",
          "optional": true,
          "commands": [
            ["text", "id", "u", "conformance@test.local", "optional"],
            ["text", "id", "p", "Tr0ubad0ur-Marmalade-7719", "optional"],
            ["click", "css", "button[type='submit']", "optional"]
          ]
        }
      ]
    }
  ]
}
